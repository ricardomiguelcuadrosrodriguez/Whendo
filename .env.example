# =======================================================
# whendo — environment configuration
# =======================================================
# Copy this file to `.env` and fill in your values.
# Only LLM_API_KEY is required to get started.
# =======================================================

# ---- LLM (used only when creating recipes from natural language) ----
LLM_PROVIDER=anthropic                # anthropic | openai | ollama
LLM_MODEL=claude-haiku-4-5-20251001   # cheap + fast for parsing
LLM_API_KEY=sk-ant-your-key-here

# If using Ollama (fully local, no API key needed):
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b
# OLLAMA_HOST=http://localhost:11434

# ---- Server ----
WHENDO_PORT=8000
WHENDO_WEB_PORT=3000
WHENDO_TIMEZONE=America/Lima
WHENDO_LOG_LEVEL=INFO

# ---- Database ----
# SQLite by default (zero config). Use Postgres if you want.
DATABASE_URL=sqlite:///./data/whendo.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/whendo

# ---- Notification channels (optional, enable what you need) ----

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# ntfy.sh (free push notifications, no account)
NTFY_SERVER=https://ntfy.sh
NTFY_DEFAULT_TOPIC=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Discord
DISCORD_WEBHOOK_URL=

# WhatsApp (via Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ---- External APIs (optional, enable what you need) ----

# OpenWeatherMap (free tier is plenty)
OPENWEATHER_API_KEY=

# Spotify (for new release tracking)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API
YOUTUBE_API_KEY=

# GitHub (for github_releases source, public repos work without a token)
GITHUB_TOKEN=
